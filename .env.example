# SFTP principal (NAS)
IMPROOV_SFTP_HOST=
IMPROOV_SFTP_PORT=2222
IMPROOV_SFTP_USER=
IMPROOV_SFTP_PASS=

# FTP secundário (quando necessário)
IMPROOV_FTP_HOST=
IMPROOV_FTP_PORT=21
IMPROOV_FTP_USER=
IMPROOV_FTP_PASS=
IMPROOV_FTP_BASE=

# SFTP VPS (opcional - usado em Revisao/atualizar_angulo.php)
IMPROOV_VPS_SFTP_HOST=
IMPROOV_VPS_SFTP_PORT=22
IMPROOV_VPS_SFTP_USER=
IMPROOV_VPS_SFTP_PASS=
IMPROOV_VPS_SFTP_REMOTE_PATH=

# Flow Connect — pendências operacionais (inicie em shadow)
FLOW_CONNECT_RENDER_APPROVAL_SLA_SECONDS=3600
FLOW_CONNECT_OPERATIONAL_SCHEDULER_IDLE_SECONDS=1
FLOW_CONNECT_ARQUIVO_MANAGER_COLLABORATOR_IDS=
FLOW_CONNECT_BRIEFING_MODE=off
FLOW_CONNECT_BRIEFING_MANAGER_COLLABORATOR_IDS=

# Briefing Online — SMTP transacional para convites e OTPs.
# Sem estes valores, o acesso externo não emite códigos.
BRIEFING_SMTP_HOST=
BRIEFING_SMTP_PORT=587
BRIEFING_SMTP_USER=
BRIEFING_SMTP_PASS=
BRIEFING_SMTP_FROM=

# Flow Connect — resumo consolidado de pendências (manter SHADOW até aprovação)
FLOW_CONNECT_PENDING_SUMMARY_MODE=off
FLOW_CONNECT_PENDING_SUMMARY_TIMES=08:15,10:15,12:15,14:15,16:15,18:15
FLOW_CONNECT_PENDING_SUMMARY_ORIGIN_URL=https://improov/ImproovWeb/PaginaPrincipal/
FLOW_CONNECT_PENDING_SUMMARY_PREVIEW_LIMIT=3
FLOW_CONNECT_PENDING_SUMMARY_NORMAL_MAX=5
FLOW_CONNECT_PENDING_SUMMARY_ATTENTION_MAX=10
FLOW_CONNECT_PENDING_SUMMARY_INCLUDE_MANAGERS=false
FLOW_CONNECT_PENDING_SUMMARY_MANAGER_COLLABORATOR_IDS=
# A fila de cobrança não possui responsável persistido; configure seus donos sem hardcode.
FLOW_CONNECT_PENDING_SUMMARY_COBRANCA_COLLABORATOR_IDS=
