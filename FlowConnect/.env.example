# Todos os modos permanecem off até migration, sync, shadow e aprovação explícita.
FLOW_CONNECT_FLOW_REVIEW_MODE=off
FLOW_CONNECT_REVIEW_MENTION_MODE=off
FLOW_CONNECT_REVIEW_ANGLE_MODE=off
FLOW_CONNECT_REVIEW_TASK_MODE=off
FLOW_CONNECT_REVIEW_DIRECTION_MODE=off
FLOW_CONNECT_REVIEW_SFTP_MODE=off
FLOW_CONNECT_REVIEW_SLA_MODE=off

# Aprovação simples pode ser apenas histórico ou DM.
FLOW_CONNECT_REVIEW_APPROVAL_DELIVERY_MODE=HISTORY_ONLY
FLOW_CONNECT_REVIEW_SLA_REPEAT_HOURS=24
FLOW_CONNECT_CLAIM_TTL_SECONDS=300
FLOW_CONNECT_SLACK_TIMEOUT_SECONDS=10
FLOW_CONNECT_FLOW_REVIEW_URL=https://improov.com.br/flow/ImproovWeb/FlowReview/index.php

# IDs provisórios: confirmar com produto/operações antes de active.
FLOW_CONNECT_REVIEW_DIRECTION_COLLABORATOR_IDS=21,2
FLOW_CONNECT_REVIEW_MANAGER_COLLABORATOR_IDS=21,9
FLOW_CONNECT_TECHNICAL_ADMIN_COLLABORATOR_IDS=21,9
FLOW_CONNECT_REVIEW_CHANNEL_ID=

# Pend\u00eancias operacionais novas: manter off at\u00e9 aplicar a migration 002 e validar em shadow.
FLOW_CONNECT_PROJETO_MANAGER_COLLABORATOR_IDS=
FLOW_CONNECT_IMAGEM_MANAGER_COLLABORATOR_IDS=
FLOW_CONNECT_FLOW_BLOCK_MANAGER_COLLABORATOR_IDS=
FLOW_CONNECT_LINKS_MANAGER_COLLABORATOR_IDS=
FLOW_CONNECT_COBRANCA_CLIENTE_MANAGER_COLLABORATOR_IDS=
FLOW_CONNECT_FOTOGRAFICO_MANAGER_COLLABORATOR_IDS=
FLOW_CONNECT_RENDER_MANAGER_COLLABORATOR_IDS=
FLOW_CONNECT_PRE_ALTERACAO_MANAGER_COLLABORATOR_IDS=
FLOW_CONNECT_UPLOAD_SUMMARY_TIMES=09:00,13:00,17:00
FLOW_CONNECT_SLA_OVERDUE_WEBHOOK_URL=

# Produtores imediatos migrados para o Flow Connect. Cron, SLA e resumos ficam fora desta etapa.
FLOW_CONNECT_CONTRATOS_MODE=off
FLOW_CONNECT_FOTOGRAFICO_MODE=off
FLOW_CONNECT_FLOWDRIVE_MODE=off
FLOW_CONNECT_UPLOAD_WORKER_MODE=off
FLOW_CONNECT_POS_PRODUCAO_MODE=active
FLOW_CONNECT_RESPOSTAS_DIARIAS_MODE=off
FLOW_CONNECT_PRE_ALTERACAO_MODE=off
FLOW_CONNECT_SIRE_MODE=off
FLOW_CONNECT_RENDER_MODE=off
FLOW_CONNECT_NOTIFICACOES_INTERNAS_MODE=off

# Já existente no projeto; não colocar o valor em código ou documentação.
SLACK_TOKEN=

# Exclusivo para testes locais/integrados. Ignorado fora de APP_ENV=local|test.
FLOW_CONNECT_TEST_MODE=false
FLOW_CONNECT_TEST_COLLABORATOR_ID=
FLOW_CONNECT_TEST_ALLOWED_PROJECT=
